# Copy to api/.env. Values below are for a laptop only.
DATABASE_URL=postgresql+psycopg://ash:ash@127.0.0.1:5434/ash_cedar
JWT_SECRET=change-me-to-a-long-random-string-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Bootstrap admin. If ADMIN_EMAIL is set, ADMIN_DATE_OF_BIRTH is required and must be 21+.
# An existing account with this email is left unchanged.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Store Admin
ADMIN_DATE_OF_BIRTH=1990-01-01
